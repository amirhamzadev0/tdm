# Exact browser origin (scheme + host + port). Used for POST origin checks.
APP_ORIGIN=http://127.0.0.1:3120
# Canonical public URL for SEO (sitemap, Open Graph, schema).
SITE_URL=http://127.0.0.1:3120

# Where orders, repair bookings and messages are saved (JSON files). Defaults to ./.data
# DATA_DIR=./.data
# Optional: get a Telegram message for every new order, booking and message.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
